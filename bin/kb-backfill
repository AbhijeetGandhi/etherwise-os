#!/usr/bin/env python3
"""Historical backfill — two phases so the cheap part runs anytime and the
costly part is bounded + resumable:

  kb-backfill ingest  [fathom|loom|all]   # Phase A: source rows + FTS, NO LLM
  kb-backfill extract [fathom|loom|all]   # Phase B: extract status='ingested'
  kb-backfill compile                      # recompile all dossiers + proof-points

Phase A is free (no model) and makes everything full-text searchable. Phase B is
the gated Sonnet spend (~$0.046/source); it only touches not-yet-extracted
sources, so a killed run resumes by re-running. The full Fathom run (~327 calls
≈ $15) needs the one-time cap bump (var/proposed-diffs/2026-06-17-...).
"""
import json
import sys
import zipfile
from datetime import datetime, timedelta, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from core import config, db  # noqa: E402
from modules.knowledge import ingest, extract, index, clients, crm, dossier, \
    proof_points  # noqa: E402

ASSETS = Path(__file__).resolve().parents[2] / "assets"
FATHOM_ZIP = ASSETS / "Fathom_Transcripts_2026-04-08_09_37_19.zip"
LOOM_JSON = ASSETS / "loom-transcripts-all.json"
IST = timezone(timedelta(hours=5, minutes=30))


def _ist_now():
    return datetime.now(IST).strftime("%Y-%m-%d %H:%M IST")


def _fathom_items():
    z = zipfile.ZipFile(FATHOM_ZIP)
    for name in z.namelist():
        if name.endswith(".json"):
            try:
                yield json.loads(z.read(name))
            except Exception:
                continue


def _loom_items():
    yield from json.loads(LOOM_JSON.read_text())


SOURCES = {"fathom": ("fathom", _fathom_items),
           "loom": ("loom", _loom_items)}


def phase_ingest(which):
    cmap = clients.load_client_map(config.DB_PATH)
    total = {"ingested": 0, "duplicate": 0}
    for key in (["fathom", "loom"] if which == "all" else [which]):
        stype, items = SOURCES[key]
        inbox = config.KNOWLEDGE_INBOX / key
        inbox.mkdir(parents=True, exist_ok=True)
        n = {"ingested": 0, "duplicate": 0}
        for payload in items():
            parsed = ingest._PARSERS[stype](payload)
            rid = parsed["source_ref"].split("/")[-1]
            occ = (parsed["occurred_dt"] or "unknown")[:10]
            path = inbox / f"{occ}__{rid}.json"
            path.write_text(json.dumps(payload, default=str))
            r = ingest.ingest_file(path, db_path=config.DB_PATH,
                                   client_map=cmap, source_type=stype)
            n[r["status"]] = n.get(r["status"], 0) + 1
        print(f"  {key}: {n}")
        for k in total:
            total[k] += n.get(k, 0)
    print(f"INGEST total: {total}")


def phase_extract(which, *, limit=None, attributed=False, model_key=None):
    """Extract status='ingested' sources → cited facts. Resumable (a killed run
    re-runs only the not-yet-extracted). Options:
      --attributed   only sources with a client_id (facts that can land in a
                     dossier); the loom run starts here (the 97 attributed).
      --limit N      per-run ceiling on sources this invocation (bounds spend;
                     re-run to drain the rest). Each process resets the gateway's
                     per-run USD accumulator, so chunking keeps a big Haiku batch
                     under PER_RUN_MAX_USD without a config change.
      --model KEY    MODELS key for the reader (default the Sonnet 'drafting'
                     tier; loom passes 'classify' = the Haiku pin)."""
    clause = "" if which == "all" else " AND source_type=?"
    args = [] if which == "all" else [which]
    if attributed:
        clause += " AND client_id IS NOT NULL"
    order = " ORDER BY client_id, occurred_dt"       # deterministic + resumable
    lim = f" LIMIT {int(limit)}" if limit else ""
    with db.connect(config.DB_PATH) as conn:
        rows = [dict(r) for r in conn.execute(
            "SELECT id, source_type, source_ref, client_id, raw_path FROM"
            " sources WHERE status='ingested'" + clause + order + lim, args)]
    if not rows:
        print("EXTRACT: nothing to extract (0 sources status=ingested"
              f"{' attributed' if attributed else ''}) — skip.")
        return
    mk = model_key or extract.EXTRACT_MODEL_KEY
    # Loom walkthroughs are dense — a 4k output ceiling truncates the JSON on the
    # richest ones. Give the reader the per-run token ceiling so a whole source
    # isn't lost to truncation.
    max_tokens = config.PER_RUN_MAX_OUTPUT_TOKENS
    print(f"extracting {len(rows)} sources (status=ingested, model={mk})…")
    metrics = {"cost_usd": 0.0, "dropped_noise": 0}
    done = facts = failed = 0
    per_client = {}
    for s in rows:
        payload = json.loads(Path(s["raw_path"]).read_text())
        parsed = ingest._PARSERS[s["source_type"]](payload)
        try:
            # cite_ref deep-links the artifact (loom → share URL) so facts click
            # straight to the recording at the anchoring phrase.
            out = extract.extract_facts(
                {"source_ref": s["source_ref"], "client_id": s["client_id"],
                 "cite_ref": parsed.get("url")},
                parsed["text"], db_path=config.DB_PATH, model_key=mk,
                max_tokens=max_tokens, metrics=metrics)
        except Exception as exc:               # truncated JSON / transient / budget
            failed += 1
            # leave the source status='ingested' (index_facts never ran) so a
            # re-run retries it — degrade-and-continue, never crash the batch.
            print(f"  ! skip {s['source_ref']}: {type(exc).__name__}: {exc}"
                  [:200])
            continue
        res = index.index_facts(config.DB_PATH, s["id"], s["client_id"], out)
        done += 1
        facts += res["inserted"]
        per_client[s["client_id"]] = per_client.get(s["client_id"], 0) \
            + res["inserted"]
        if done % 25 == 0:
            print(f"  …{done}/{len(rows)} sources, {facts} facts,"
                  f" ${metrics['cost_usd']:.4f}")
    print(f"EXTRACT done: {done} sources, {facts} facts"
          f" ({metrics['dropped_noise']} dropped noise, {failed} skipped); "
          f"${metrics['cost_usd']:.4f}")
    for cid in sorted(per_client, key=lambda c: -per_client[c]):
        print(f"    {cid or '(unattributed)'}: {per_client[cid]} facts")


def phase_compile():
    # the stamp is read PER CLIENT, when that client's compile happens — a
    # single `now` taken before the loop makes last_compiled_at older than the
    # facts the same pass wrote (see knowledge/daily._stamp).
    cmap = clients.load_client_map(config.DB_PATH)
    for c in cmap:
        crm.ingest_crm(config.DB_PATH, c["client_id"], c["name"],
                       c["identifiers"], c.get("ledger_labels"))
        out = dossier.compile_dossier(config.DB_PATH, c["client_id"],
                                      c["name"], _ist_now())
        note = ""
        if out["status"] != "compiled":
            note = f"  [{out['status']}, index still says {out['prev_facts']}]"
        elif out.get("prev_facts") not in (None, out["facts"]):
            note = f"  [was {out['prev_facts']}]"
        print(f"  dossier {c['client_id']}: {out['facts']} facts{note}")
    print("  proof-points:",
          proof_points.compile_proof_points(config.DB_PATH, _ist_now()))


def _flag(name, default=None):
    """Tiny flag reader: --name VALUE (VALUE optional -> True)."""
    if name not in sys.argv:
        return default
    i = sys.argv.index(name)
    if i + 1 < len(sys.argv) and not sys.argv[i + 1].startswith("--"):
        return sys.argv[i + 1]
    return True


def main():
    phase = sys.argv[1] if len(sys.argv) > 1 else "ingest"
    which = sys.argv[2] if len(sys.argv) > 2 and \
        not sys.argv[2].startswith("--") else "all"
    if phase == "ingest":
        phase_ingest(which)
    elif phase == "extract":
        lim = _flag("--limit")
        phase_extract(which, limit=int(lim) if lim else None,
                      attributed=bool(_flag("--attributed", False)),
                      model_key=_flag("--model"))
    elif phase == "compile":
        phase_compile()
    else:
        sys.exit(f"unknown phase {phase!r}")


if __name__ == "__main__":
    main()
