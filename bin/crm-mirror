#!/usr/bin/env python3
"""CRM Airtable mirror (v3 SQLite -> Airtable copy-out), replacing v2
sync_airtable. Runner-wrapped (module='crm'). Per-table shadow gates are read
INSIDE the mirror (SHADOW_MODE['crm'] for proposals/contracts;
SHADOW_MODE['crm_transactions'] for transactions) — both DECOUPLED from 'upwork',
so the mirror flips without touching the scanner's ClickUp path.

One-way copy-out: never reads Airtable back into the ledger, never moves money.
Shadow-first: while gated, intended writes land in shadow_ledger (target=airtable)
for review before anything writes live.

Usage: PYTHONPATH=. python3 bin/crm-mirror
"""
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from core import runner  # noqa: E402
from modules.crm import mirror  # noqa: E402


def task(ctx):
    return mirror.run(ctx)


if __name__ == "__main__":
    result = runner.run_task("crm_mirror", task, module="crm")
    print(json.dumps({"run_id": result.run_id, "status": result.status,
                      "metrics": result.metrics}, indent=1))
    sys.exit(0 if result.status in ("completed", "skipped_empty") else 1)
