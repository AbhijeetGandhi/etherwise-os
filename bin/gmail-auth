#!/usr/bin/env python3
"""Gmail OAuth consent — GATED, run WITH Abhijeet (browser step).

This mints .credentials/gmail-api.json for email_poll.py (read-only Gmail).
It is the one human-in-the-loop step Phase 4 cannot automate. Prereqs Abhijeet
provides once:
  1. A Google Cloud project with the Gmail API enabled.
  2. An OAuth client (type: Desktop app) -> client_id + client_secret.
  3. Scope: https://www.googleapis.com/auth/gmail.readonly (READ-ONLY).
Put client_id/secret in .credentials/gmail-oauth-client.json:
  {"client_id": "...", "client_secret": "..."}

Then run this; it prints a consent URL, you approve in the browser, paste back
the code, and it writes the token. stdlib only; no send scope is ever requested.
"""
import json
import sys
import urllib.parse
import urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from core import config  # noqa: E402

SCOPE = "https://www.googleapis.com/auth/gmail.readonly"
REDIRECT = "urn:ietf:wg:oauth:2.0:oob"   # manual copy/paste (no local server)
CLIENT_FILE = config.CREDENTIALS_DIR / "gmail-oauth-client.json"
TOKEN_FILE = config.CREDENTIALS_DIR / "gmail-api.json"


def main():
    if not CLIENT_FILE.exists():
        sys.exit(f"missing {CLIENT_FILE} — add client_id/client_secret first "
                 "(see this script's docstring).")
    cfg = json.loads(CLIENT_FILE.read_text())
    auth_url = "https://accounts.google.com/o/oauth2/v2/auth?" + \
        urllib.parse.urlencode({
            "client_id": cfg["client_id"], "redirect_uri": REDIRECT,
            "response_type": "code", "scope": SCOPE,
            "access_type": "offline", "prompt": "consent"})
    print("\n1) Open this URL and approve (read-only Gmail):\n")
    print(auth_url)
    code = input("\n2) Paste the code here: ").strip()

    data = urllib.parse.urlencode({
        "code": code, "client_id": cfg["client_id"],
        "client_secret": cfg["client_secret"], "redirect_uri": REDIRECT,
        "grant_type": "authorization_code"}).encode()
    req = urllib.request.Request("https://oauth2.googleapis.com/token",
                                 data=data, method="POST")
    with urllib.request.urlopen(req, timeout=30) as resp:
        tok = json.loads(resp.read().decode())

    out = {"client_id": cfg["client_id"], "client_secret": cfg["client_secret"],
           "refresh_token": tok["refresh_token"],
           "access_token": tok["access_token"],
           "expiry": (datetime.now(timezone.utc)
                      + timedelta(seconds=tok.get("expires_in", 3000) - 60)
                      ).isoformat()}
    TOKEN_FILE.write_text(json.dumps(out))
    TOKEN_FILE.chmod(0o600)
    print(f"\nwrote {TOKEN_FILE} (600). email_poll.py can now read client mail.")


if __name__ == "__main__":
    main()
