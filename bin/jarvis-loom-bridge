#!/usr/bin/env python3
"""Attribute unmapped Loom recordings through the client registry (mirrors the
Fathom bridge). Deterministic title/transcript match -> auto-heal; temporal
correlation + a CAPPED Haiku proposer -> queue; LLM-flagged internal/owner-only
Looms -> excluded (never queued). Bounded (newest-first) + idempotent.

    PYTHONPATH=. python3 bin/jarvis-loom-bridge [--limit N] [--queue-cap N]
                                                [--proposer-cap N] [--recheck]
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from core import config, runner                              # noqa: E402
from modules.jarvis import loom_bridge                       # noqa: E402


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--limit", type=int, default=50)
    ap.add_argument("--queue-cap", type=int, default=40)
    ap.add_argument("--proposer-cap", type=int,
                    default=config.JARVIS_LOOM_MAX_PROPOSALS,
                    help="max Haiku residue-proposer calls this run")
    ap.add_argument("--recheck", action="store_true",
                    help="re-evaluate already-queued Loom events after the "
                         "registry learns new aliases/domains")
    args = ap.parse_args()

    def task(ctx):
        if args.recheck:
            dbp = ctx.db_path or config.DB_PATH
            return loom_bridge.recheck_queued(dbp)
        return loom_bridge.sync_unmapped(
            ctx, limit=args.limit, queue_cap=args.queue_cap,
            proposer_cap=args.proposer_cap)

    result = runner.run_task("jarvis_loom_bridge", task, module="system")
    print(json.dumps({"status": result.status, "metrics": result.metrics}))
    return 0 if result.status in ("completed", "skipped_empty") else 1


if __name__ == "__main__":
    raise SystemExit(main())
