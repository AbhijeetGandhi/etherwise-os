#!/usr/bin/env python3
"""Show — and optionally apply — what the CURRENT rules say about the queue.

    PYTHONPATH=. python3 bin/jarvis-triage-queue                 # dry run
    PYTHONPATH=. python3 bin/jarvis-triage-queue --apply
    PYTHONPATH=. python3 bin/jarvis-triage-queue --states queued,held --apply

THIS SCRIPT IS NO LONGER THE MECHANISM — it is the window onto it.

Until 2026-08-19 it was the only consumer of `assets/sender-rules.json`, and
that was the bug: the 27 `bulk_subdomains` in that file were written from the 58
rows sitting in `held` on 2026-08-14 and then never applied to them, because
applying them required a human to remember to run this. Three months of bank
promos and SaaS blasts sat on the Review board next to rules that named them.

The decisions now live in `modules/jarvis/resweep.py`, which `jarvis_sweep` runs
at the top of every sweep whenever the rules change. This script calls exactly
that code, so what it prints is what the automatic path will do — the two cannot
drift, which is the only reason a preview is worth anything.

`--apply` remains useful for the moment after a rule edit when you want the
effect now rather than at the next sweep; it is idempotent either way.
"""
from __future__ import annotations

import argparse
import sys
from collections import Counter, defaultdict
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from core import config, db, registry                      # noqa: E402
from modules.jarvis import resweep                         # noqa: E402
from modules.jarvis import sender_rules as SR              # noqa: E402


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--apply", action="store_true")
    ap.add_argument("--states", default="queued,held",
                    help="event states to triage (default queued,held)")
    args = ap.parse_args()

    states = tuple(s.strip() for s in args.states.split(",") if s.strip())
    assert all(s in resweep.STATES for s in states), args.states

    reg = registry.load()
    rules, learned = SR.load_rules(), SR.load_learned()

    with db.connect(config.DB_PATH) as conn:
        decisions = resweep.plan(conn, reg=reg, rules=rules, learned=learned,
                                 states=states)
        buckets = defaultdict(list)
        by_rule = Counter()
        for r, d in decisions:
            buckets[d["action"]].append((r, d))
            by_rule[d["rule"]] += 1

        excl = buckets["exclude"]
        prop = buckets["propose"]
        keep = buckets["keep"]
        skip = buckets["skip"]

        print(f"events in {list(states)}: {len(decisions)}")
        print(f"  auto-exclude : {len(excl)}")
        print(f"  propose      : {len(prop)}")
        print(f"  still ASK    : {len(keep)}")
        print(f"  untouched    : {len(skip)}")
        print("\n=== rules that fired ===")
        for k, n in by_rule.most_common():
            print(f"   {k:34} {n}")

        if excl:
            print("\n=== auto-excluded ===")
            for r, d in excl:
                print(f"   {SR.domain_of(r['author']):32} {d['reason']:34}"
                      f" {(r['subject'] or '')[:40]}")
        if prop:
            print("\n=== proposed to a client (one click to confirm) ===")
            for r, d in prop:
                print(f"   {SR.domain_of(r['author']):32} -> {d['client_id']:16}"
                      f" {(r['subject'] or '')[:40]}")

        print(f"\n=== NEEDS ABHIJEET ({len(keep)}) ===")
        grouped = defaultdict(list)
        for r, d in keep:
            grouped[SR.domain_of(r["author"])].append((r, d))
        for dom, items in sorted(grouped.items(), key=lambda x: -len(x[1])):
            r, d = items[0]
            print(f"   {dom:32} x{len(items):<3} {d['reason']}")
            print(f"      e.g. {(r['subject'] or '')[:70]}")

        if skip:
            print("\n=== untouched (out of this script's authority) ===")
            for rule, n in Counter(d["rule"] for _r, d in skip).most_common():
                why = next(d["reason"] for _r, d in skip if d["rule"] == rule)
                print(f"   {rule:20} x{n:<3} {why}")

        if not args.apply:
            print("\nDRY RUN — nothing written. Re-run with --apply, or just"
                  " wait: jarvis_sweep applies this automatically whenever the"
                  " rules change.")
            return 0

        written = resweep.apply(conn, decisions)
        conn.commit()
        print(f"\nAPPLIED — {written['excluded']} excluded,"
              f" {written['proposed']} proposed,"
              f" {len(keep)} left for Abhijeet")
    return 0


if __name__ == "__main__":
    sys.exit(main())
