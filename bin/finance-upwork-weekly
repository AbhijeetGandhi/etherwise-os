#!/usr/bin/env python3
"""Weekly Upwork-CSV import CHECK (human-gated commit — Abhijeet's choice 2026-06-30).

Closes the agency financial gap WITHOUT re-OAuth: Abhijeet manually exports the
agency Transaction-History CSV each week (there is no API for it) and drops it in
finance-inbox/upwork/ named '*-upwork-agency-fullhistory.csv'. This job runs the
importer in DRY-RUN, and when there is something to apply — new reconciled rows,
a pending amountless-row quarantine the CSV would resolve (e.g. agency txns the
API hands us without an amount), a reconcile failure, or a value mismatch needing
a decision — it EMAILS Abhijeet to run `bin/finance-import-upwork --commit`.

NEVER commits: the authoritative-ledger write stays a human action. Quiet when
there is nothing to do (no email). Internal-only + an operational email alert (the
same notify channel as task-failure alerts) — no business external writes.
"""
import importlib.machinery
import importlib.util
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from core import notify, runner  # noqa: E402

COMMIT_CMD = "PYTHONPATH=. python3 bin/finance-import-upwork --commit"


def _load_importer():
    """Load the extensionless importer bin as a module (no subprocess/env juggling)."""
    path = Path(__file__).resolve().parent / "finance-import-upwork"
    loader = importlib.machinery.SourceFileLoader("finance_import_upwork", str(path))
    spec = importlib.util.spec_from_loader("finance_import_upwork", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def _send(subject: str, html: str, ctx) -> None:
    """Email Abhijeet; never let a send failure fail the check (log it, report stays)."""
    try:
        notify.send_gmail(subject, html)
        ctx.log(f"notified: {subject}")
    except Exception as exc:                         # noqa: BLE001
        ctx.log(f"notify send FAILED (report still written): {exc!r}")


def task(ctx) -> dict:
    res = _load_importer().run(commit=False)          # DRY-RUN — never writes

    if res.get("abort"):
        reason = res["abort"]
        if "did not reconcile" in reason:             # a real problem -> alert
            _send("Upwork weekly import BLOCKED — a CSV did not reconcile",
                  f"<p>{reason}</p><pre>{json.dumps(res.get('recon'), indent=1)}</pre>"
                  f"<p>Fix/replace the export in finance-inbox/upwork/ and it will retry.</p>", ctx)
            ctx.log(f"abort (reconcile): {reason}")
        else:                                         # just no file dropped this week -> quiet
            ctx.log(f"quiet: {reason}")
        return {"status": "abort", "reason": reason}

    new = res.get("new_inserted", 0)
    qr = res.get("quarantine_resolved", 0)            # would-resolve in dry-run
    vd = res.get("value_diffs_for_abhijeet", 0)
    if new or qr or vd:
        html = (
            "<h2>Upwork agency/personal import ready to commit</h2><ul>"
            f"<li><b>{new}</b> new reconciled row(s) (net ${res.get('new_net_usd')})</li>"
            f"<li><b>{qr}</b> amountless quarantined row(s) the CSV would resolve</li>"
            f"<li><b>{vd}</b> value mismatch(es) needing your decision</li></ul>"
            f"<p>Review then run <code>{COMMIT_CMD}</code> to apply. Nothing was written.</p>"
            f"<pre>{json.dumps({k: v for k, v in res.items() if not k.startswith('_')}, indent=1)}</pre>")
        _send(f"Upwork weekly import: {new} new, {qr} to resolve — commit when ready", html, ctx)
        ctx.log(f"action: new={new} quar_resolve={qr} value_diffs={vd}")
    else:
        ctx.log("quiet: nothing to apply")
    return {"status": "ok", "new_inserted": new, "quarantine_resolved": qr,
            "value_diffs": vd}


if __name__ == "__main__":
    result = runner.run_task("finance_upwork_weekly", task, module="finance")
    print(json.dumps(result.metrics))
    sys.exit(0 if result.status in ("completed", "skipped_empty") else 1)
