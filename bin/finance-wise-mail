#!/usr/bin/env python3
"""Pull Wise settlement emails ("Your money's been sent") into the ledger.

Read-only on the mailbox (select readonly + BODY.PEEK); the only writes are
`transactions` rows whose canonical keys are IDENTICAL to the ones the Wise CSV
importer would produce, so this can never double-count against a CSV import.

    PYTHONPATH=. python3 bin/finance-wise-mail --dry-run      # report, write nothing
    PYTHONPATH=. python3 bin/finance-wise-mail --days 90      # widen the window
    PYTHONPATH=. python3 bin/finance-wise-mail

Always prints the INCOME GAP at the end: the revenue that email cannot key and
the ledger is therefore still missing. Fees being current is not the books being
current, and the difference must never be silent.
"""
from __future__ import annotations

import argparse
import email
import sys
from datetime import datetime, timedelta
from email.header import decode_header, make_header
from email.utils import parsedate_to_datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from core import config, db, runner                          # noqa: E402
from modules.finance import payment_mail_rail as pmr         # noqa: E402
from modules.finance import wise_mail                        # noqa: E402
from modules.jarvis import imap_rail                         # noqa: E402


def _collect_and_commit(ctx, args) -> dict:
    """The whole run, under the runner so it lands a `runs` row.

    That row is not bookkeeping: config.SOURCES reads run recency to decide
    whether a source is stale, and with the CSV export retired this rail is the
    ONLY thing keeping Wise money current. A rail that dies silently would leave
    the books frozen with nothing to say so.
    """
    inbox = config.PAYMENT_MAIL_INBOX
    pw = imap_rail.app_password(inbox)
    if not pw:
        sys.exit(f"no app password on file for {inbox}")

    client = imap_rail._connect(config.JARVIS_IMAP_HOST, inbox, pw)
    parsed, incomplete, rows_by_tid, arrivals = [], [], {}, []
    try:
        client.select(config.PAYMENT_MAIL_MAILBOX, readonly=True)
        since = (datetime.now() - timedelta(days=args.days)).strftime("%d-%b-%Y")
        # multi-word SEARCH terms MUST be quoted or Gmail answers BAD
        # One pass over ALL Wise mail: an arrival and a settlement are the two
        # halves of the same payment and there is no reason to walk the mailbox
        # twice for them.
        uids = []
        for dom in ("wise.com", "transferwise.com"):
            typ, data = client.uid("SEARCH", None, "FROM", dom, "SINCE", since)
            if typ == "OK" and data and data[0]:
                uids += data[0].split()
        uids = sorted(set(uids), key=lambda u: int(u))
        print(f"wise emails in last {args.days}d: {len(uids)}")

        for uid in uids:
            typ, d = client.uid("FETCH", uid, "(BODY.PEEK[])")
            if typ != "OK" or not d or not d[0]:
                continue
            msg = email.message_from_bytes(d[0][1])
            subj = str(make_header(decode_header(msg.get("Subject", ""))))
            body = pmr._body_text(msg)
            try:
                paid = parsedate_to_datetime(msg.get("Date")).strftime("%Y-%m-%d")
            except Exception:
                paid = None

            s = wise_mail.parse_settlement(subj, body)
            if s:
                if s.get("incomplete"):
                    incomplete.append((s["transfer_id"], s.get("have")))
                else:
                    parsed.append(s)
                    rows_by_tid[s["transfer_id"]] = wise_mail.ledger_rows(
                        s, paid_date=paid)
                continue

            a = wise_mail.parse_arrival(subj, body)
            if a and not a.get("incomplete"):
                arrivals.append((a, paid))
            elif a:
                incomplete.append((a.get("payer"), "arrival-unparsed"))
    finally:
        try:
            client.logout()
        except Exception:
            pass

    all_rows = [r for rows in rows_by_tid.values() for r in rows]
    print(f"parsed {len(parsed)} settlements -> {len(all_rows)} ledger rows")
    print(f"parsed {len(arrivals)} arrivals (income)")
    if incomplete:
        print(f"!! {len(incomplete)} settlement emails did not fully parse "
              f"(Wise template change?): {incomplete[:5]}")

    gap = {"count": 0, "total_minor": 0, "rows": []}
    with db.connect(config.DB_PATH) as conn:
        if args.dry_run:
            present = sum(
                1 for r in all_rows
                if conn.execute("SELECT 1 FROM transactions WHERE canonical_key=?",
                                (r["canonical_key"],)).fetchone())
            print(f"DRY RUN settlement — would insert {len(all_rows) - present}, "
                  f"{present} already in the ledger")
            for r in all_rows:
                if not conn.execute(
                        "SELECT 1 FROM transactions WHERE canonical_key=?",
                        (r["canonical_key"],)).fetchone():
                    print(f"   + {r['creation_dt']} {r['canonical_key']:34}"
                          f" {r['amount_minor'] / 100:>10,.2f} {r['currency']}"
                          f"  {r['category']}")
            new_inc = [(a, p) for a, p in arrivals
                       if not wise_mail.existing_income(conn, a, p)]
            print(f"DRY RUN income — would insert {len(new_inc)}, "
                  f"{len(arrivals) - len(new_inc)} already in the ledger")
            for a, p in new_inc:
                print(f"   + {p} {wise_mail.income_key(a, p):38}"
                      f" {a['amount_minor'] / 100:>10,.2f} {a['currency']}"
                      f"  {a['payer'][:24]}")
        else:
            out = wise_mail.commit(conn, all_rows)
            inc = wise_mail.commit_income(conn, arrivals)
            conn.commit()
            print(f"settlement: inserted {out['inserted']}, already present "
                  f"{out['already_present']}")
            print(f"income:     inserted {inc['inserted']}, already present "
                  f"{inc['already_present']}")

        gap = wise_mail.income_gap(conn)
        print(f"\nINCOME GAP — revenue email cannot key, still missing from the "
              f"ledger: {gap['count']} payment(s), "
              f"{gap['total_minor'] / 100:,.2f}")
        for payer, cid, minor, cur, dt in gap["rows"]:
            print(f"   ! {dt}  {str(payer)[:26]:26} {(minor or 0) / 100:>10,.2f}"
                  f" {cur}  -> {cid}")

    if incomplete:
        # A Wise template change is the one failure that would silently freeze
        # the books now that the CSV is retired. It must alarm, not just print.
        ctx.anomaly("wise_mail_unparsed", "critical",
                    {"count": len(incomplete), "sample": incomplete[:5],
                     "note": "Wise email template may have changed — the ledger"
                             " stops updating until the parser is re-pointed"})
    if not parsed and not arrivals:
        # Zero Wise mail in a 21-day window is not normal for this business;
        # it means notifications were turned off, filtered, or the search broke.
        ctx.anomaly("wise_mail_empty_window", "warn",
                    {"days": args.days, "note": "no Wise emails found at all"})

    return {"emails": len(uids), "settlements": len(parsed),
            "arrivals": len(arrivals), "incomplete": len(incomplete),
            "settlement_rows": len(all_rows),
            "income_gap_count": gap["count"],
            "income_gap_minor": gap["total_minor"],
            "dry_run": bool(args.dry_run)}


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--days", type=int, default=75)
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()
    # module='finance' but this rail makes ZERO external writes (local ledger
    # only, read-only IMAP), so the shadow gate has nothing to suppress.
    result = runner.run_task(
        "finance_wise_mail", lambda ctx: _collect_and_commit(ctx, args),
        module="system")
    return 0 if result.status in ("completed", "skipped_empty") else 1


if __name__ == "__main__":
    sys.exit(main())
