#!/usr/bin/env python3
"""Librarian CLI — answer a kb question, print JSON. Used by the cockpit's
'ask' action so the MODEL CALL runs OUT OF the cockpit server process
(architecture: cockpit is a view+action plane, no model calls in-process).

Usage: kb-ask "<question>" [client_id]
"""
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from modules.knowledge import librarian  # noqa: E402
from core import config  # noqa: E402


def main():
    if len(sys.argv) < 2 or not sys.argv[1].strip():
        print(json.dumps({"error": "question required"}))
        return
    question = sys.argv[1]
    client = sys.argv[2] if len(sys.argv) > 2 and sys.argv[2] else None
    try:
        out = librarian.answer(question, db_path=config.DB_PATH,
                               client_id=client)
    except Exception as e:               # never leak a stack to the UI
        out = {"error": str(e)[:300], "grounded": False, "answer": "",
               "citations": []}
    print(json.dumps(out))


if __name__ == "__main__":
    main()
