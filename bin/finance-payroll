#!/usr/bin/env python3
"""Phase 5 — payroll run. PREP-ONLY: computes the run, records what WOULD be paid,
and emits a pre-disbursement checklist. It NEVER disburses (no payout/transfer
path; Abhijeet pays manually).

Source roster: Payroll/employees.json (gross_salary + monthly_tds/monthly_pt as
INPUTS). A missing TDS/PT is SURFACED and BLOCKS finalization — never computed.
On --apply (only when finalizable + reconciling) writes payroll_runs +
payroll_lines; the doctor's #6 then reconciles them. Money is integer paise.

Usage: PYTHONPATH=. python3 bin/finance-payroll --period 2026-06 [--apply]
"""
import datetime
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from core import config, db  # noqa: E402
from modules.finance import money, payroll, doctor, roster  # noqa: E402

ROSTER = Path(__file__).resolve().parents[2] / "Payroll" / "employees.json"
REPORT = Path(__file__).resolve().parents[2] / "reports" / "finance-payroll.md"
SLIPS = Path(__file__).resolve().parents[1] / "var" / "payslips"   # gitignored


def _render_slips(cfg, run) -> dict:
    """Render a slip per line. Tries PDF (WeasyPrint); on a lib-load failure
    (macOS SIP strips DYLD so Homebrew pango isn't found by the system python),
    falls back to HTML so a slip is always produced. Prep-only artifact."""
    from modules.finance import payslip
    co = dict(cfg["company"]); co["slip_prefix"] = "ETW"   # no signatory block now
    by_id = {e["employee_id"]: e for e in cfg["employees"]}
    out_dir = SLIPS / run["period"]
    pdf, locked, unlocked_no_dob, html = [], 0, [], []
    for line in run["lines"]:
        emp = by_id.get(line["employee_id"], {})
        base = out_dir / f"{line['employee_id']}_{(line['name'] or '').replace(' ', '_')}"
        try:
            r = payslip.render_pdf(line, emp, run["period"], run["pay_date"], co, str(base) + ".pdf")
            pdf.append(r["path"])
            if r["locked"]:
                locked += 1
            else:
                unlocked_no_dob.append(line["employee_id"])   # DOB missing -> not lockable
        except Exception:
            out_dir.mkdir(parents=True, exist_ok=True)
            (Path(str(base) + ".html")).write_text(
                payslip.render_html(line, emp, run["period"], run["pay_date"], co))
            html.append(str(base) + ".html")
    return {"pdf": len(pdf), "locked": locked, "unlocked_no_dob": unlocked_no_dob,
            "html_fallback": len(html), "dir": str(out_dir)}


def _checklist(roster_active, run) -> list:
    """Pre-disbursement blockers to resolve manually (slips render with '—')."""
    items = []
    for e in roster_active:
        gaps = [k for k in ("pan", "bank_account", "ifsc", "date_of_birth", "department")
                if not e.get(k)]
        if gaps:
            items.append(f"{e['employee_id']} {e['name']}: missing {', '.join(gaps)}"
                         + (" (no DOB -> PDF can't be locked)" if "date_of_birth" in gaps else ""))
    for m in run["missing"]:
        items.append(f"{m['employee_id']} {m['name']}: TDS/PT INPUT missing "
                     f"({', '.join(m['missing'])}) — provide from CA/Airtable, never computed")
    return items


def run_payroll(period: str, apply: bool) -> dict:
    cfg = roster.load(ROSTER)        # Airtable (DOB/PAN/Dept) over local; graceful fallback
    active = [e for e in cfg["employees"] if e.get("status") == "Active"]
    run = payroll.compute_run(cfg["employees"], period)
    checklist = _checklist(active, run)

    wrote = False
    if apply:
        if not run["finalizable"]:
            return {"abort": "run not finalizable — missing inputs / reconcile errors",
                    "missing": run["missing"], "recon_errors": run["recon_errors"]}
        with db.connect(config.DB_PATH) as conn:
            # idempotent replace: drop child lines then the run (FK), then re-insert
            old = conn.execute("SELECT id FROM payroll_runs WHERE period=?", (period,)).fetchone()
            if old:
                conn.execute("DELETE FROM payroll_lines WHERE run_id=?", (old["id"],))
                conn.execute("DELETE FROM payroll_runs WHERE id=?", (old["id"],))
            cur = conn.execute(
                "INSERT INTO payroll_runs (period, pay_date, headcount,"
                " gross_minor, tds_minor, pt_minor, net_minor, status) VALUES"
                " (?,?,?,?,?,?,?, 'prepared')",
                (period, run["pay_date"], run["headcount"], run["gross_minor"],
                 run["tds_minor"], run["pt_minor"], run["net_minor"]))
            rid = cur.lastrowid
            for l in run["lines"]:
                e = l["earnings"]
                conn.execute(
                    "INSERT INTO payroll_lines (run_id, employee_id, name, gross_minor,"
                    " basic_minor, hra_minor, special_minor, lta_minor, tds_minor,"
                    " pt_minor, net_minor) VALUES (?,?,?,?,?,?,?,?,?,?,?)",
                    (rid, l["employee_id"], l["name"], l["gross_minor"], e["basic"],
                     e["hra"], e["special"], e["lta"], l["tds_minor"], l["pt_minor"],
                     l["net_minor"]))
        wrote = True

    slips = None
    if "--render-slips" in sys.argv and run["finalizable"]:
        slips = _render_slips(cfg, run)

    def m(x):
        return str(money.from_minor(x))
    dr = doctor.run(config.DB_PATH)
    return {
        "mode": "APPLY" if apply else "DRY-RUN", "period": period,
        "roster_source": cfg.get("_roster_source"),
        "pay_date": run["pay_date"], "headcount": run["headcount"],
        "finalizable": run["finalizable"], "written": wrote,
        "gross": m(run["gross_minor"]), "tds": m(run["tds_minor"]),
        "pt": m(run["pt_minor"]), "net": m(run["net_minor"]),
        "lines": [{"id": l["employee_id"], "name": l["name"], "gross": m(l["gross_minor"]),
                   "tds": m(l["tds_minor"]), "pt": m(l["pt_minor"]), "net": m(l["net_minor"])}
                  for l in run["lines"]],
        "MISSING_INPUTS": run["missing"],
        "checklist": checklist,
        "doctor_6": next((c.status for c in dr.checks if c.invariant == "#6 payroll"), "?"),
        "slips": slips,
        "disburses": False,
    }


def main() -> int:
    period = datetime.date.today().strftime("%Y-%m")
    if "--period" in sys.argv:
        period = sys.argv[sys.argv.index("--period") + 1]
    res = run_payroll(period, "--apply" in sys.argv)
    REPORT.parent.mkdir(parents=True, exist_ok=True)
    REPORT.write_text("# Payroll run (Phase 5, prep-only)\n\n```\n"
                      + json.dumps(res, indent=1) + "\n```\n")
    print(json.dumps(res, indent=1))
    return 0 if "abort" not in res else 1


if __name__ == "__main__":
    sys.exit(main())
