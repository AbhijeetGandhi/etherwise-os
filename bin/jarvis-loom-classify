#!/usr/bin/env python3
"""Attribute unmapped Loom recordings by KIND + domain vocabulary (QUEUE-12 —
replaces name-matching, which had no transcript signal). One Haiku call per Loom:
non-client kinds are excluded (cleans the KB); client-work is attributed by the
per-client vocabulary fingerprint -> high-conf provisional map / medium queue /
low or unknown excluded. Deterministic registry name-matches still full-heal.

    PYTHONPATH=. python3 bin/jarvis-loom-classify [--limit N] [--max N]
        [--dry-run] [--reclassify-queued] [--heal-mapped]
        [--source-type loom|fathom]

--dry-run spends the LLM but writes nothing (measure kind distribution + cost).
--reclassify-queued re-routes the existing queued Looms instead of scanning
unmapped sources. --heal-mapped backfills the KB for events already mapped to a
client whose source is still unattributed (runs the same heal the approval path
does; idempotent, no LLM spend). --source-type generalises every mode to the
Fathom residue (owner-only/internal calls the deterministic bridge skipped) --
ONE classifier, not a third. Build the fingerprints first: jarvis-loom-fingerprints.
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from core import config, runner                              # noqa: E402
from modules.jarvis import loom_classifier                   # noqa: E402


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--limit", type=int, default=200,
                    help="max unmapped sources scanned this run (newest-first)")
    ap.add_argument("--max", type=int, default=config.JARVIS_LOOM_CLASSIFY_MAX,
                    dest="max_calls", help="per-run ceiling on Haiku classify calls")
    ap.add_argument("--dry-run", action="store_true",
                    help="classify + report, write nothing to the ledger")
    ap.add_argument("--reclassify-queued", action="store_true",
                    help="re-route the already-queued Looms instead of scanning")
    ap.add_argument("--heal-mapped", action="store_true",
                    help="backfill: heal the KB for events already mapped to a "
                         "client whose source is still unattributed (no LLM spend)")
    ap.add_argument("--guard-excluded", action="store_true",
                    help="re-open EXCLUDED events on which a registered client "
                         "demonstrably speaks (no LLM spend). An 'internal' "
                         "verdict is falsified by a client being in the room.")
    ap.add_argument("--source-type", choices=("loom", "fathom"), default="loom",
                    help="corpus to operate on (default loom)")
    ap.add_argument("--transcript-words", type=int, default=None,
                    dest="transcript_words",
                    help="words of transcript sent per call (default "
                         "config.JARVIS_LOOM_TRANSCRIPT_WORDS). A Fathom CALL is "
                         "several times longer than a Loom narration and its "
                         "client vocabulary is not front-loaded, so judging one "
                         "on its first 1500 words is judging a fragment.")
    args = ap.parse_args()

    def task(ctx):
        if args.guard_excluded:
            return loom_classifier.guard_excluded(
                ctx, source_type=args.source_type, dry_run=args.dry_run)
        if args.heal_mapped:
            return loom_classifier.heal_mapped(ctx, source_type=args.source_type)
        if args.reclassify_queued:
            return loom_classifier.reclassify_queued(
                ctx, source_type=args.source_type, max_calls=args.max_calls,
                transcript_words=args.transcript_words, dry_run=args.dry_run)
        out = loom_classifier.classify_unmapped(
            ctx, source_type=args.source_type, limit=args.limit,
            max_calls=args.max_calls, transcript_words=args.transcript_words,
            dry_run=args.dry_run)
        # THE NIGHTLY DEFAULT ALSO JUDGES THE QUEUED FATHOM CALLS (2026-11-01).
        # fathom_bridge queues a call on its participant list alone — the
        # moment an external name is on it. This classifier then skipped the
        # row for ever ("event already exists"), so seven "Impromptu Google
        # Meet Meeting" interviews sat on the Review board with no client and
        # 0.0 confidence, waiting for a human to say what a transcript read
        # would have said. A bounded reclassify pass on the queued Fathom rows
        # closes that gap each night; it reads the full transcript, which is
        # strictly more evidence than the bridge had.
        if args.source_type == "loom":
            try:
                out["fathom_queued"] = loom_classifier.reclassify_queued(
                    ctx, source_type="fathom",
                    max_calls=config.JARVIS_FATHOM_RECLASSIFY_MAX,
                    dry_run=args.dry_run)
            except Exception as exc:                      # noqa: BLE001
                out["fathom_queued"] = {"error": repr(exc)[:200]}
        return out

    result = runner.run_task("jarvis_loom_classify", task, module="system")
    print(json.dumps({"status": result.status, "metrics": result.metrics}))
    return 0 if result.status in ("completed", "skipped_empty") else 1


if __name__ == "__main__":
    raise SystemExit(main())
