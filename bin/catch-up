#!/usr/bin/env python3
"""Restart the scheduled jobs whose source is ACTUALLY overdue.

Why this exists (2026-07-20 incident): macOS does not queue missed
StartCalendarInterval windows. A window that passes while the Mac is asleep or
off is skipped outright — so the Mac slept from Jul-17 to Jul-20 and the daily
connects rail, the hourly sync/mirror and two weekly finance pulls simply never
ran. launchd was behaving correctly the whole time; every job resumed exactly on
its slot once the machine was awake.

Blanket RunAtLoad is the wrong fix. It fires EVERY job on every load: a
thundering herd at boot, a spurious run every time a plist is reloaded, and
repeat side-effects from anything that emails. This asks the source registry
which sources are overdue and kickstarts only those — so the freshness
mechanism we already have becomes self-healing.

Guards:
  - only sources marked catch_up (manual imports and emailing jobs opt out)
  - only sources whose status is stale/down; a healthy source is never touched
  - NOT INSTALLED != failed-to-start: a launchd label absent from `launchctl
    list` was never bootstrapped — a one-time setup error, flagged loudly with
    the exact bootstrap command, never a retry loop (2026-08-07: jarvis_sweep's
    plist existed but was never loaded, so the shim raised catch_up_failed 26x)
  - give up after N consecutive failures, held PER SOURCE KEY off the kickstart
    trail (not the target's run log, which is empty for a job that never ran)
  - a per-task cooldown, so a job that is broken (not merely missed) is not
    re-kicked on every wake
  - staggered starts; several rails share the one Chrome marker tab
  - `launchctl kickstart` without -k: a job already running is left alone, and
    the runner's flock stops overlap regardless

    PYTHONPATH=. python3 bin/catch-up [--dry-run]
"""
from __future__ import annotations

import json
import subprocess
import sys
import time
from datetime import datetime, timedelta
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from core import config, db, runner, source_health as sh   # noqa: E402

TASK_NAME = "catch_up"


def _recently_ran(conn, task: str, now: datetime, minutes: int) -> bool:
    """True if this task started within the cooldown — don't pile on a run that
    has only just happened."""
    cutoff = (now - timedelta(minutes=minutes)).isoformat(timespec="seconds")
    row = conn.execute(
        "SELECT 1 FROM runs WHERE task_name=? AND started_at >= ? LIMIT 1",
        (task, cutoff)).fetchone()
    return row is not None


def _keeps_failing(conn, task: str, limit: int) -> bool:
    """True when the task's last `limit` runs ALL failed. Such a job is broken,
    not merely missed: restarting it just loops and buries the real fault under
    repeat anomalies. Give up and let the brief carry it to a human."""
    rows = conn.execute(
        "SELECT status FROM runs WHERE task_name=? ORDER BY id DESC LIMIT ?",
        (task, limit)).fetchall()
    return len(rows) == limit and all(r[0] == "failed" for r in rows)


def _kick_failures_for(conn, key: str, target_task: str) -> int:
    """How many times catch-up has failed to KICKSTART this source since its
    target last succeeded — unresolved `catch_up_failed` anomalies naming the
    key, detected after the most recent successful target run.

    This, NOT the target's run log, is the give-up signal that actually holds.
    The 2026-08-07 loop happened because `_keeps_failing` reads the TARGET's
    `runs`: a job that was never installed has ZERO runs, so `0 == 3` is False
    and the guard never tripped — the shim re-kicked and re-raised
    `catch_up_failed` every 30 min. The kickstart failures themselves are the
    consecutive evidence. Anchoring on the last success makes the guard
    self-clear: once the source runs again, the count resets to 0.
    (detected_at is the anomaly clock, completed_at IST-offset — julianday
    reconciles the two, same as the System tab's recovered logic.)"""
    like = f'%"key": "{key}"%'
    last_ok = conn.execute(
        "SELECT MAX(completed_at) FROM runs WHERE task_name=?"
        " AND status='completed'", (target_task,)).fetchone()[0]
    if last_ok:
        return conn.execute(
            "SELECT COUNT(*) FROM anomalies WHERE kind='catch_up_failed'"
            " AND resolved_at IS NULL AND detail_json LIKE ?"
            " AND julianday(detected_at) > julianday(?)",
            (like, last_ok)).fetchone()[0]
    return conn.execute(
        "SELECT COUNT(*) FROM anomalies WHERE kind='catch_up_failed'"
        " AND resolved_at IS NULL AND detail_json LIKE ?", (like,)).fetchone()[0]


def _already_open(conn, kind: str, key: str) -> bool:
    """True if there is already an UNRESOLVED anomaly of this kind naming the
    key. Keeps the not-installed / gave-up signals one-time-loud: raised once
    and then quiet until the fault is fixed, never a fresh critical every wake."""
    return conn.execute(
        "SELECT 1 FROM anomalies WHERE kind=? AND resolved_at IS NULL"
        " AND detail_json LIKE ? LIMIT 1",
        (kind, f'%"key": "{key}"%')).fetchone() is not None


def clear_installed(conn, _loaded=None, uid: int = 0,
                    sources=None) -> list:
    """Close `catch_up_not_installed` anomalies whose labels are now loaded.

    WHY (2026-08-13): `_already_open` above is the one-time-loud guard, and it
    keys off `resolved_at IS NULL` — but NOTHING in production ever sets
    `resolved_at` (the cockpit deliberately computes 'recovered' instead, and
    the only writers are one-off scripts in var/cc-runs/). So the guard was not
    one-time-loud, it was ONCE PER KEY, EVER: jarvis_sweep's row from
    2026-08-11 was still open when its label was reinstalled today, which means
    the NEXT time a reboot dropped it the alarm would have stayed silent — the
    exact silent failure this shim exists to prevent, in the shim itself.

    Resolving on 'the label is loaded again' is precise: that IS the condition
    the anomaly reports, so the signal re-arms the moment the fault is fixed and
    cannot re-fire while it persists. Only checks labels actually named by an
    open anomaly, so it costs no launchctl calls on a healthy system."""
    _loaded = is_loaded if _loaded is None else _loaded   # defined below
    rows = conn.execute(
        "SELECT id, detail_json FROM anomalies WHERE"
        " kind='catch_up_not_installed' AND resolved_at IS NULL").fetchall()
    by_label = {s.get("launchd_label") for s in
                (sources if sources is not None else config.SOURCES)}
    cleared = []
    for row in rows:
        try:
            named = json.loads(row[1] or "{}").get("sources") or []
        except (TypeError, ValueError):
            continue
        labels = {n.get("label") for n in named if n.get("label")}
        # only labels this registry still knows about; a retired one can never
        # come back loaded and must not pin the anomaly open forever
        labels &= by_label
        if labels and all(_loaded(lbl, uid) for lbl in labels):
            conn.execute("UPDATE anomalies SET resolved_at=datetime('now')"
                         " WHERE id=?", (row[0],))
            cleared.extend(n.get("key") for n in named)
    return cleared


def _bootstrap_cmd(label: str, uid: int) -> str:
    """The exact command a human runs to install a job launchd has never heard
    of — surfaced verbatim in the anomaly so nobody has to reconstruct it."""
    return (f"launchctl bootstrap gui/{uid} "
            f"{config.LAUNCH_AGENTS_DIR}/{label}.plist")


def is_loaded(label: str, uid: int, _run=subprocess.run) -> bool:
    """True if launchd knows this label (present in `launchctl list`). A label
    ABSENT was never bootstrapped: a setup error, not a transient failure — so
    catch-up must not treat it as something a kickstart could ever fix."""
    proc = _run(["launchctl", "list", label],
                capture_output=True, text=True, timeout=30)
    return proc.returncode == 0


def overdue_sources(conn, now: datetime, sources=None) -> list:
    """The sources that are both unhealthy AND safe to restart unattended."""
    health = sh.source_health(conn, now=now, sources=sources)
    out = []
    for s in health["sources"]:
        if s["status"] not in ("stale", "down"):
            continue                      # degraded ran fine; a restart won't help
        src = next((x for x in (sources if sources is not None else config.SOURCES)
                    if x["key"] == s["key"]), {})
        if not src.get("catch_up") or not src.get("launchd_label"):
            continue                      # manual / opted out / no agent to kick
        out.append({**s, "launchd_label": src["launchd_label"]})
    return out


def kickstart(label: str, uid: int, _run=subprocess.run) -> tuple:
    """launchctl kickstart WITHOUT -k: never interrupt a run already in flight."""
    proc = _run(["launchctl", "kickstart", f"gui/{uid}/{label}"],
                capture_output=True, text=True, timeout=30)
    return proc.returncode, (proc.stderr or proc.stdout or "").strip()


def run(ctx, now: datetime = None, uid: int = None, _sleep=time.sleep,
        _kick=kickstart, _loaded=is_loaded, dry_run: bool = False) -> dict:
    import os
    now = now or datetime.now(config.TZ)
    uid = os.getuid() if uid is None else uid
    dbp = ctx.db_path or config.DB_PATH

    with db.connect(dbp) as conn:
        # re-arm the not-installed alarm for anything that has since been
        # installed, BEFORE deciding what to raise this run (see clear_installed)
        cleared = [] if dry_run else clear_installed(conn, _loaded, uid)
        if cleared:
            ctx.log(f"not-installed alarm re-armed for: {', '.join(cleared)}")
        candidates = overdue_sources(conn, now)
        due, skipped, gave_up, not_installed = [], [], [], []
        max_fail = config.CATCH_UP_MAX_CONSECUTIVE_FAILURES
        for s in candidates:
            label = s["launchd_label"]
            # NOT INSTALLED != failed-to-start. A label launchd has never heard
            # of was never bootstrapped — a setup error a kickstart can never
            # fix. Flag it once, loudly, with the command, and never loop on it.
            if not _loaded(label, uid):
                not_installed.append(
                    {"key": s["key"], "label": label,
                     "bootstrap": _bootstrap_cmd(label, uid),
                     "overdue_h": s["hours_overdue"]})
            elif _recently_ran(conn, s["task_name"], now,
                               config.CATCH_UP_COOLDOWN_MIN):
                skipped.append({"key": s["key"], "why": "ran within cooldown"})
            # give up when EITHER the target keeps crashing (its runs all fail)
            # OR the kickstart itself keeps failing (per-key, from the anomaly
            # trail) — the latter is what the target-run guard alone missed.
            elif (_keeps_failing(conn, s["task_name"], max_fail)
                  or _kick_failures_for(conn, s["key"], s["task_name"])
                  >= max_fail):
                gave_up.append({"key": s["key"], "why": "failing every attempt"})
            else:
                due.append(s)
        # one-time-loud: which not-installed / gave-up keys have no OPEN anomaly
        # yet. Resolved inside the connection; the kickstarts (below) are I/O and
        # stay outside the with-block per the tight-transaction rule.
        fresh_not_installed = [
            n for n in not_installed
            if dry_run or not _already_open(conn, "catch_up_not_installed",
                                            n["key"])]
        fresh_gave_up = [
            g for g in gave_up
            if dry_run or not _already_open(conn, "catch_up_gave_up", g["key"])]

    kicked, failed = [], []
    for i, s in enumerate(due):
        if dry_run:
            kicked.append({"key": s["key"], "dry_run": True})
            continue
        if i:
            _sleep(config.CATCH_UP_STAGGER_SEC)
        code, err = _kick(s["launchd_label"], uid)
        entry = {"key": s["key"], "label": s["launchd_label"],
                 "overdue_h": s["hours_overdue"]}
        if code == 0:
            kicked.append(entry)
            ctx.log(f"kickstarted {s['key']} ({s['label']}) —"
                    f" {s['hours_overdue']}h past its deadline")
        else:
            failed.append({**entry, "error": err[:200]})
            ctx.log(f"FAILED to kickstart {s['key']}: {err[:200]}")

    if failed:
        # a job we cannot restart is exactly the silent-death case this whole
        # mechanism exists to prevent — say so loudly
        ctx.anomaly("catch_up_failed", "critical",
                    {"failed": failed, "uid": uid})
    for n in not_installed:
        ctx.log(f"NOT restarting {n['key']} — its launchd label {n['label']} is"
                f" not loaded. Install it once:  {n['bootstrap']}")
    if fresh_not_installed:
        # a setup error, not a transient failure — point the human at the fix
        ctx.anomaly("catch_up_not_installed", "critical",
                    {"sources": fresh_not_installed, "uid": uid,
                     "detail": "launchd label absent — run the bootstrap command"
                               " once; this is not a restart problem"})
    if fresh_gave_up:
        # not a restart problem — say plainly that a human is needed
        ctx.anomaly("catch_up_gave_up", "critical",
                    {"sources": [g["key"] for g in fresh_gave_up],
                     "detail": "failing every attempt; restarting will not fix it"})
    for g in gave_up:
        ctx.log(f"NOT restarting {g['key']} — it has failed its last"
                f" {config.CATCH_UP_MAX_CONSECUTIVE_FAILURES} attempts;"
                " this needs a human, not another kickstart")
    if not candidates:
        ctx.log("all sources fresh — nothing to catch up")
    return {"overdue": len(candidates), "kicked": [k["key"] for k in kicked],
            "failed": [f["key"] for f in failed],
            "skipped_cooldown": [s["key"] for s in skipped],
            "gave_up": [g["key"] for g in gave_up],
            "not_installed": [n["key"] for n in not_installed],
            "rearmed": cleared}


def main() -> int:
    dry = "--dry-run" in sys.argv
    result = runner.run_task(TASK_NAME, lambda ctx: run(ctx, dry_run=dry),
                             module="system")
    print(result.metrics)
    return 0 if result.status == "completed" else 1


if __name__ == "__main__":
    raise SystemExit(main())
