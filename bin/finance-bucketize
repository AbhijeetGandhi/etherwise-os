#!/usr/bin/env python3
"""Phase 3 — persist the P&L bucket. Writes pnl.bucket(row) to transactions.pnl_bucket
for every canonical row, so the money picture is REPRODUCIBLE from stored data and
auditable by query (Abhijeet 2026-06-26: the per-source `category` and the computed
bucket() disagreed, so the P&L could not be re-derived). bin/finance-pnl reads
pnl_bucket; the doctor verifies it still matches bucket(). Idempotent.

Usage: PYTHONPATH=. python3 bin/finance-bucketize [--apply]   (default dry-run)
"""
import json
import sys
from collections import Counter
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from core import config, db  # noqa: E402
from modules.finance import pnl, accrual, salary_lines  # noqa: E402

REPORT = Path(__file__).resolve().parents[2] / "reports" / "finance-bucketize.md"

# amount_base_minor included: bucket() is amount-DEPENDENT since the 2026-07-08
# bank-spend rules (employee salary floor) — omitting it fed the rule 0 and
# silently mis-bucketed salary-shaped transfers.
_COLS = ("record_id, source, type, upwork_type, category, accounting_subtype,"
         " description, pnl_bucket, amount_base_minor")


def run(apply: bool) -> dict:
    # FIRST, before anything is bucketed: a salary whose narration forgot to say
    # so. Abhijeet, 2026-09-07, on Yogita's July pay reading as an owner draw:
    # "There's something wrong yogita must have got paid on july". Her lines
    # stopped at the IFSC, so the classifier saw a generic bank expense. This
    # writes `category='salary'` from the ledger's own knowledge of who his
    # payroll people are; pnl.bucket then does the rest with no new branch, and
    # it has to happen HERE because the bucket pass below reads that category.
    with db.connect(config.DB_PATH) as conn:
        named = (salary_lines.apply(conn) if apply
                 else {"changed": len(salary_lines.rows_to_fix(conn)), "payees": []})

    changed = 0
    counts = Counter()
    with db.connect(config.DB_PATH) as conn:
        rows = [dict(r) for r in conn.execute(
            f"SELECT {_COLS} FROM transactions WHERE canonical_key IS NOT NULL")]
        for r in rows:
            b = pnl.bucket(r)
            counts[b] += 1
            if r.get("pnl_bucket") != b:
                changed += 1
                if apply:
                    conn.execute("UPDATE transactions SET pnl_bucket=?,"
                                 " updated_at=datetime('now') WHERE record_id=?",
                                 (b, r["record_id"]))
    # THE EFFECTIVE MONTH, in the same pass and for the same reason. A bank line
    # that names the month it is FOR ("Salary august" paid 3 Sep) must be
    # attributed to that month; migration 016 decided this on 2026-08-03 and
    # nothing was ever built, so it drifted for five months (Abhijeet,
    # 2026-09-07: "I know we discussed this in the past I don't know why this
    # mistake was made"). It belongs HERE because it needs pnl_bucket to be
    # fresh, this is the step that makes it fresh, and the cockpit already runs
    # this step after every import — so the loop closes with no human in it.
    with db.connect(config.DB_PATH) as conn:
        months = (accrual.apply(conn) if apply
                  else {"changed": len(accrual.rows_to_set(conn))})
    return {"mode": "APPLY" if apply else "DRY-RUN", "rows": len(rows),
            "changed": changed, "by_bucket": dict(counts),
            "effective_month_changed": months["changed"],
            "effective_month_since": accrual.ACCRUAL_SINCE,
            "unnarrated_salary_fixed": named["changed"],
            "unnarrated_salary_payees": named.get("payees", [])}


def main() -> int:
    res = run("--apply" in sys.argv)
    REPORT.parent.mkdir(parents=True, exist_ok=True)
    REPORT.write_text("# Bucketize (Phase 3)\n\n```\n" + json.dumps(res, indent=1) + "\n```\n")
    print(json.dumps(res, indent=1))
    return 0


if __name__ == "__main__":
    sys.exit(main())
