<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>io.etherwise.v3.crm-mirror</string>
  <!-- Framework Python (June-14 TCC pattern); logs outside ~/Desktop -->
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework/Versions/3.9/Resources/Python.app/Contents/MacOS/Python</string>
    <string>/Users/abhijeet/Desktop/Etherwise/etherwise-v3/bin/crm-mirror</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/abhijeet/Desktop/Etherwise/etherwise-v3</string>
  <key>EnvironmentVariables</key>
  <dict><key>PYTHONPATH</key><string>/Users/abhijeet/Desktop/Etherwise/etherwise-v3</string></dict>
  <key>StandardOutPath</key><string>/Users/abhijeet/Library/Logs/Etherwise-v3/crm-mirror.log</string>
  <key>StandardErrorPath</key><string>/Users/abhijeet/Library/Logs/Etherwise-v3/crm-mirror.log</string>
  <key>RunAtLoad</key><false/>
  <!-- hourly :50 — right after the :45 upwork-sync, so the mirror pushes fresh data -->
  <key>StartCalendarInterval</key>
  <dict><key>Minute</key><integer>50</integer></dict>
</dict>
</plist>
