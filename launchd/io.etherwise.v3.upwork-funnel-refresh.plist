<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>io.etherwise.v3.upwork-funnel-refresh</string>
  <!-- the nightly funnel refresh (2026-10-11, his "yes start number 1 now"):
       messages for new conversations, every proposal list, a fresh read of the
       last 60 days, the backfill, and the tests' links. Read-only on Upwork;
       about 30 to 40 minutes of paced calls, after his working hours. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework/Versions/3.9/Resources/Python.app/Contents/MacOS/Python</string>
    <string>-m</string>
    <string>modules.upwork.funnel_refresh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    <key>PYTHONPATH</key><string>/Users/abhijeet/Desktop/Etherwise/etherwise-v3</string>
  </dict>
  <key>StandardOutPath</key><string>/Users/abhijeet/Library/Logs/Etherwise-v3/upwork-funnel-refresh.log</string>
  <key>StandardErrorPath</key><string>/Users/abhijeet/Library/Logs/Etherwise-v3/upwork-funnel-refresh.log</string>
  <key>RunAtLoad</key><false/>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>5</integer>
    <key>Minute</key><integer>20</integer>
  </dict>
</dict>
</plist>
