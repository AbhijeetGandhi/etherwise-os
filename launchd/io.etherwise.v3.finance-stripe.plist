<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>io.etherwise.v3.finance-stripe</string>
  <!-- Framework Python (June-14 TCC pattern); logs outside ~/Desktop -->
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework/Versions/3.9/Resources/Python.app/Contents/MacOS/Python</string>
    <string>bin/finance-stripe-sync</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/abhijeet/Desktop/Etherwise/etherwise-v3</string>
  <key>EnvironmentVariables</key>
  <dict><key>PYTHONPATH</key><string>/Users/abhijeet/Desktop/Etherwise/etherwise-v3</string></dict>
  <key>StandardOutPath</key><string>/Users/abhijeet/Library/Logs/Etherwise-v3/finance-stripe.log</string>
  <key>StandardErrorPath</key><string>/Users/abhijeet/Library/Logs/Etherwise-v3/finance-stripe.log</string>
  <key>RunAtLoad</key><false/>
  <!-- daily 06:20 IST: after the 05:35 connects rail and the 06:00 weekly
       Upwork finance pull; imports whatever Stripe export was dropped (a no-op
       re-run when nothing changed) -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>20</integer></dict>
</dict>
</plist>
