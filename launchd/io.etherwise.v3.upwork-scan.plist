<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>io.etherwise.v3.upwork-scan</string>
  <!-- Framework Python (FDA-granted); NO WorkingDirectory and logs OUTSIDE
       ~/Desktop — both required or launchd fails to spawn (exit 78) or Python
       dies on '.' in sys.path. Proven by v2's plists. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework/Versions/3.9/Resources/Python.app/Contents/MacOS/Python</string>
    <string>-m</string>
    <string>modules.upwork.scan_pipeline</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    <key>PYTHONPATH</key><string>/Users/abhijeet/Desktop/Etherwise/etherwise-v3</string>
  </dict>
  <key>StandardOutPath</key><string>/Users/abhijeet/Library/Logs/Etherwise-v3/upwork-scan.log</string>
  <key>StandardErrorPath</key><string>/Users/abhijeet/Library/Logs/Etherwise-v3/upwork-scan.log</string>
  <key>RunAtLoad</key><false/>
  <!-- Every 15 minutes since 2026-10-18 (hourly at :15 before), at his word
       "can we do scann for job posts more frequently like every 15 or 30
       minutes so that we can apply quickly"; config.UPWORK_SCAN_MINUTES holds
       the same four minutes and a test keeps them equal. The pulse sits at
       :05/:20/:35/:50, so the two still never share a minute. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>0</integer></dict>
    <dict><key>Minute</key><integer>15</integer></dict>
    <dict><key>Minute</key><integer>30</integer></dict>
    <dict><key>Minute</key><integer>45</integer></dict>
  </array>
</dict>
</plist>
